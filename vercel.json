{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "redirects": [
    {"source": "/E-portfolio/", "destination": "/", "permanent": true},
    {"source": "/E-portfolio/:path*/", "destination": "/:path*/", "permanent": true},
    {"source": "/E-portfolio/:path*", "destination": "/:path*", "permanent": true}
  ]
}
